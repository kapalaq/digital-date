server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Railway private networking uses IPv6 — must use their internal DNS resolver
  resolver [fd12:3456:789a::1] valid=10s;

  location /api/ {
    set $upstream http://${BACKEND_URL};
    proxy_pass $upstream;
  }
  location /socket.io/ {
    set $upstream http://${BACKEND_URL};
    proxy_pass $upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }
  # Hashed assets are content-addressed -> cache forever.
  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; }

  # index.html must never be cached, or browsers keep loading a stale bundle.
  location = /index.html { add_header Cache-Control "no-store"; }

  location / { try_files $uri $uri/ /index.html; }
}
